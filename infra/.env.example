# =============================================================================
# infra/docker-compose.yml — Keycloak + il suo PostgreSQL
# =============================================================================
# Copia questo file in infra/.env PRIMA di avviare il compose:
#
#   cp infra/.env.example infra/.env
#
# docker compose legge il .env dalla directory del file compose, non dalla
# radice del repository: un .env nella root NON viene visto da questo stack.
#
# I nomi qui devono corrispondere esattamente a quelli in
# infra/docker-compose.yml. Non sono le stesse variabili del database
# applicativo (docker/.env) né quelle lette da FastAPI (.env in root).
# =============================================================================

# Database interno di Keycloak — usato solo da Keycloak, non dall'app.
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak_change_me

# Utente amministratore iniziale della console Keycloak (http://localhost:8080).
# Keycloak lo crea come "temporary admin" al primo avvio: creane uno definitivo
# dalla console e rimuovi questo appena il realm è configurato.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin_change_me
