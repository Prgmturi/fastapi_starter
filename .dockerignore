# =============================================================================
# Docker build context
# =============================================================================
# Tutto ciò che è elencato qui resta fuori dal contesto di build.
#
# Con BuildKit (il builder predefinito) il client invia solo i percorsi che
# le istruzioni COPY usano: .venv e le cache alla radice non partono comunque.
# Questo file decide cosa resta fuori DENTRO quei percorsi (per esempio le
# __pycache__ sotto src/) e ferma i segreti anche se un giorno qualcuno
# scrive COPY . .
#
# I pattern partono dalla radice del contesto: "__pycache__/" esclude solo
# ./__pycache__. Per escludere a qualsiasi profondità serve "**/".
#
# ATTENZIONE: README.md, pyproject.toml, uv.lock, src/, alembic/ e alembic.ini
# servono alla build — non aggiungerli qui.
# =============================================================================

# Virtualenv e artefatti Python
.venv/
venv/
**/__pycache__/
**/*.py[oc]
build/
dist/
wheels/
*.egg-info/

# Cache dei tool
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Git e metadati di repository
.git/
.gitignore
.github/
.pre-commit-config.yaml

# Segreti — non devono mai entrare nel contesto di build
**/.env
**/.env.*
!**/.env.example

# Test e documentazione: non fanno parte dell'immagine di runtime
tests/
docs/

# Compose e Dockerfile stessi (il Dockerfile è passato con -f)
docker/
infra/

# Editor e sistema operativo
.idea/
.vscode/
.claude/
**/.DS_Store
