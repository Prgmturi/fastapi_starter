# =============================================================================
# Application
# =============================================================================
APP_NAME=fastapi_starter
# APP_VERSION is read from the installed package; set it only to override
# production: startup fails while development values like the ones in this
# file remain, and the error lists them (README, Configuration reference)
APP_ENVIRONMENT=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# =============================================================================
# Server
# =============================================================================
# Read by python -m fastapi_starter.serve, the Docker image's command, and by
# its healthcheck. The uvicorn command of the README (development) takes its
# own --host and --port. compose.yaml publishes the API on SERVER_PORT.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1
# Seconds open requests get when the process is asked to stop; keep it
# below the stop timeout of the container (docker stop waits 10 seconds)
SERVER_TIMEOUT_GRACEFUL_SHUTDOWN=5
# The proxies whose X-Forwarded-For sets the client address in the logs, as a
# JSON list of addresses or networks. Production refuses "*".
SERVER_FORWARDED_ALLOW_IPS=["127.0.0.1"]
# The frontends allowed to call the API from a browser. The same list decides
# which pages may call /auth/refresh and /auth/logout: list the frontend's
# origin here even when a proxy serves it on the same origin as the API.
SERVER_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Largest request body in bytes; a larger one gets 413. Default 64 KiB.
SERVER_MAX_BODY_SIZE=65536

# =============================================================================
# Database
# =============================================================================
# The db service of compose.yaml, seen from the host. Compose reads the port,
# the name, the user and the password from this file too, so the database it
# creates and the app agree.
DATABASE_DRIVER=postgresql+asyncpg
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=appbase
DATABASE_USER=appbase
DATABASE_PASSWORD=appbase_secret_change_me
# At least 1 connection and 0 or more overflow: SQLAlchemy reads 0 and -1
# as "no limit", so the app refuses them (README, Configuration reference)
DATABASE_POOL_SIZE=5
DATABASE_POOL_MAX_OVERFLOW=10
# Seconds to open a connection, and seconds a query may run: a slower query
# answers 500 and Postgres stops it. Migrations have no limit.
DATABASE_CONNECT_TIMEOUT=5
DATABASE_COMMAND_TIMEOUT=30
DATABASE_ECHO=false

# Integration tests only (uv run pytest -m integration, README "Integration
# tests"): the same server, another database. The name must end in _test,
# because the tests create and drop tables in it.
TEST_DATABASE_HOST=localhost
TEST_DATABASE_PORT=5433
TEST_DATABASE_NAME=appbase_test
TEST_DATABASE_USER=appbase
TEST_DATABASE_PASSWORD=appbase_secret_change_me


# =============================================================================
# Keycloak
# =============================================================================
# The keycloak service of compose.yaml, seen from the host: compose publishes
# it on KEYCLOAK_PORT
KEYCLOAK_HOST=localhost
KEYCLOAK_PORT=8080
KEYCLOAK_SCHEME=http
# Keycloak's address as the browser sees it, when it differs from the one
# above (in Docker: KEYCLOAK_HOST=keycloak, KEYCLOAK_PUBLIC_URL=https://auth.example.com).
# The login redirect and the token issuer use it, so it must match Keycloak's
# KC_HOSTNAME. Unset: the same as KEYCLOAK_SCHEME://KEYCLOAK_HOST:KEYCLOAK_PORT.
# KEYCLOAK_PUBLIC_URL=https://auth.example.com
KEYCLOAK_REALM=fastapi-starter
KEYCLOAK_CLIENT_ID=fastapi-backend
# The secret of the client in the realm compose.yaml imports
# (docker/keycloak/realm-dev.json). It is public: production refuses it.
KEYCLOAK_CLIENT_SECRET=fastapi-backend-dev-secret
# Clients whose access tokens the API accepts (azp claim), as a JSON list.
# Unset: only KEYCLOAK_CLIENT_ID. Example with a separate frontend client:
# KEYCLOAK_ALLOWED_CLIENTS=["fastapi-backend","web-frontend"]
# Expected aud claim. Empty: not checked. Before setting it, add an
# Audience mapper to the client in Keycloak (README, Keycloak setup).
KEYCLOAK_AUDIENCE=
# The frontend's callback URLs, as a JSON list compared exactly. /auth/login
# and /auth/token refuse any other redirect_uri with 422. Unset: only
# Keycloak's "Valid redirect URIs" decide. Set it in production.
# KEYCLOAK_ALLOWED_REDIRECT_URIS=["http://localhost:3000/callback"]
KEYCLOAK_COOKIE_SECURE=false
KEYCLOAK_COOKIE_NAME=rt
KEYCLOAK_COOKIE_SAMESITE=lax