# =============================================================================
# docker/docker-compose.yaml — PostgreSQL dell'applicazione
# =============================================================================
# Copia questo file in docker/.env PRIMA di avviare il compose:
#
#   cp docker/.env.example docker/.env
#
# docker compose legge il .env dalla directory del file compose: il .env in
# radice del repository NON viene visto da questo stack.
#
# ATTENZIONE: questi valori devono corrispondere a DATABASE_NAME, DATABASE_USER
# e DATABASE_PASSWORD nel .env in radice, da cui li legge FastAPI. Sono due
# file diversi che descrivono lo stesso database: se divergono, il container
# parte e l'applicazione non riesce a connettersi.
# =============================================================================

APP_DB_NAME=appbase
APP_DB_USER=appbase
APP_DB_PASSWORD=appbase_secret_change_me
